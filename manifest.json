{
  "manifest_version": 3,
  "name": "JOBFILL",
  "short_name": "JOBFILL",
  "version": "1.0.0",
  "description": "Save your details once, then autofill job & internship application forms in one click. Learns new fields as you go.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "JOBFILL — Autofill forms",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "autofill-logo.png",
      "48": "autofill-logo.png",
      "128": "autofill-logo.png"
    }
  },
  "icons": {
    "16": "autofill-logo.png",
    "48": "autofill-logo.png",
    "128": "autofill-logo.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "schema.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}